---
import type { CollectionEntry } from "astro:content";

type Entry = CollectionEntry<"posts"> | CollectionEntry<"notes">;

interface Props {
  entries: Entry[];
  showKind?: boolean;
}

const { entries, showKind = false } = Astro.props;

const sorted = [...entries].sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<ul class="entry-list">
  {
    sorted.map((entry) => {
      const formattedDate = entry.data.date.toLocaleDateString("en-US", {
        year: "numeric",
        month: "long",
        day: "numeric",
      });
      const kind = entry.collection === "notes" ? "Note" : "Post";
      return (
        <li class="entry-item">
          <a href={`${import.meta.env.BASE_URL}${entry.collection}/${entry.id}`}>
            {showKind && <span class="entry-kind">{kind}</span>}
            <span class="entry-title">{entry.data.title}</span>
            {entry.data.description && (
              <span class="entry-description">{entry.data.description}</span>
            )}
            <time datetime={entry.data.date.toISOString()}>{formattedDate}</time>
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  .entry-list {
    list-style: none;
    padding: 0;
  }

  .entry-item {
    border-bottom: 1px solid var(--color-border);
  }

  .entry-item:first-child {
    border-top: 1px solid var(--color-border);
  }

  .entry-item a {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-lg) 0;
    text-decoration: none;
    color: var(--color-text);
  }

  .entry-item a:hover .entry-title {
    color: var(--color-text-secondary);
  }

  .entry-kind {
    font-family: var(--font-heading);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
  }

  .entry-title {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
    transition: color 0.15s ease;
  }

  .entry-description {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .entry-item time {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    color: var(--color-text-tertiary);
    margin-top: var(--space-xs);
  }
</style>
